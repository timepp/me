        "args": [
            "-v",
            "-i",
            "c:\\cloud\\INFO\\cert\\azure_tosexng_proxy_key.pem",
            "-D",
            "1080",
            "timepp@52.184.82.147"
        ],
        "statusPort": 1080
    },
    {
