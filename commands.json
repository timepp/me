    {
        "id": "8a7b1151-4555-4ebd-baf7-12e0738e55a3",
        "name": "Font Link fallback",
        "tags": [
            "configuration",
            "myenv"
        ],
        "type": "powerShell",
        "elevated": true,
        "applyScript": "$key = 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\FontLink\\SystemLink'; $item = Get-ItemProperty -LiteralPath $key; $item.PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' } | ForEach-Object { $values = @($_.Value); $values = @('Qingyuan.ttc,Qingyuan') + @($values | Where-Object { $_ -ne 'Qingyuan.ttc,Qingyuan' }); New-ItemProperty -Path $key -Name $_.Name -Value $values -PropertyType MultiString -Force | Out-Null }",
        "statusScript": "$key = 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\FontLink\\SystemLink'; $ok = $true; (Get-ItemProperty -LiteralPath $key).PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' } | ForEach-Object { if (@($_.Value)[0] -ne 'Qingyuan.ttc,Qingyuan') { $ok = $false } }; Write-Output $ok"
    },
    {
        "id": "1e866f3e-918c-493b-b989-a88b3b6c0fd7",
        "name": "Font Link special",
        "tags": [
            "configuration",
            "myenv"
        ],
        "type": "powerShell",
        "elevated": true,
        "applyScript": "$key = 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\FontLink\\SystemLink'; @('Consolas','Source Code Pro','Monaco','Bitstream Vera Sans Mono') | ForEach-Object { New-ItemProperty -Path $key -Name $_ -Value @('SimSun.ttc, SimSun') -PropertyType MultiString -Force | Out-Null }",
        "statusScript": "$key = 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\FontLink\\SystemLink'; $item = Get-ItemProperty -LiteralPath $key; $ok = $true; @('Consolas','Source Code Pro','Monaco','Bitstream Vera Sans Mono') | ForEach-Object { if ((@($item.$_) -join \"`0\") -ne 'SimSun.ttc, SimSun') { $ok = $false } }; Write-Output $ok"
    },
    {
        "id": "3cd8e2ea-bad9-4ec5-9ef2-d9c0acd78d2b",
        "name": "Outlook URL protocol",
        "tags": [
            "configuration",
            "myenv"
        ],
        "type": "powerShell",
        "elevated": true,
        "applyScript": "$outlook = (Get-ItemProperty -LiteralPath 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\OUTLOOK.EXE').' (default)'; if (-not $outlook) { $outlook = (Get-ItemProperty -LiteralPath 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\OUTLOOK.EXE').'(default)' }; $root = 'Registry::HKEY_CLASSES_ROOT\\outlook'; New-Item -Path \"$root\\shell\\open\\command\" -Force | Out-Null; New-ItemProperty -Path $root -Name '(default)' -Value 'URL:OutlookItem' -Force | Out-Null; New-ItemProperty -Path $root -Name 'URL Protocol' -Value '' -Force | Out-Null; New-ItemProperty -Path \"$root\\shell\\open\\command\" -Name '(default)' -Value ('\"' + $outlook + '\" /select \"%1\"') -Force | Out-Null",
        "statusScript": "Write-Output ([bool](Get-ItemProperty -LiteralPath 'Registry::HKEY_CLASSES_ROOT\\outlook\\shell\\open\\command' -ErrorAction SilentlyContinue))"
    },
