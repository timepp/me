    {
        "id": "95b33f4c-54b5-4b65-a4e1-24dcc393933b",
        "name": "Disable automatic folder type discovery",
        "tags": [
            "configuration",
            "myenv"
        ],
        "type": "powerShell",
        "applyScript": "$root = 'Registry::HKEY_CURRENT_USER\\Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\Shell'; Remove-Item -LiteralPath \"$root\\BagMRU\" -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -LiteralPath \"$root\\Bags\" -Recurse -Force -ErrorAction SilentlyContinue; New-Item -Path \"$root\\Bags\\AllFolders\\Shell\" -Force | Out-Null; New-ItemProperty -Path \"$root\\Bags\\AllFolders\\Shell\" -Name FolderType -Value NotSpecified -PropertyType String -Force | Out-Null; New-ItemProperty -Path $root -Name 'BagMRU Size' -Value 10000 -PropertyType DWord -Force | Out-Null",
        "statusScript": "$root = 'Registry::HKEY_CURRENT_USER\\Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\Shell'; $type = (Get-ItemProperty -LiteralPath \"$root\\Bags\\AllFolders\\Shell\" -Name FolderType -ErrorAction SilentlyContinue).FolderType; Write-Output ((-not (Test-Path -LiteralPath \"$root\\BagMRU\")) -and $type -eq 'NotSpecified')"
    },
