    {
        "id": "c9cc4535-2817-4753-9340-57fdd962cfa7",
        "name": "git config: alias lg",
        "description": "config git for easier use",
        "tags": [
            "git"
        ],
        "type": "terminal",
        "command": "git",
        "args": [
            "config",
            "--global",
            "alias.lg",
            "log --color --graph --pretty=format:'%C(magenta)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cd) %C(bold blue)<%an>%Creset' --abbrev-commit --date='format-local:%Y-%m-%d %H:%M'"
        ]
    }
